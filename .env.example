# Copy to .env.local (ignored by git) and fill in. Every variable is described in
# docs/reference/environments.md. The values below work with the local database
# started by `npm run db:start` (ports 553xx).

APP_ENV=local

# The app connects as app_server (password set by `npm run db:migrate`; locally app_server_local).
DATABASE_URL=postgresql://app_server:app_server_local@127.0.0.1:55322/postgres

# Migrations run as the owner. For cloud projects, use the session pooler string.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Required for cloud projects; optional locally.
# APP_SERVER_DB_PASSWORD=

# From `npm run db:status` (API_URL and PUBLISHABLE_KEY / ANON_KEY locally).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. From `npm run db:status` (SECRET_KEY / SERVICE_ROLE_KEY locally).
SUPABASE_SERVICE_ROLE_KEY=

# Sentry stays off while this is empty. Set it to try the integration locally.
NEXT_PUBLIC_SENTRY_DSN=
